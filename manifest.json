{
  "manifest_version": 3,
  "name": "Minimal New Tab",
  "version": "2.1.0",
  "description": "Чистая страница новой вкладки с блокнотом. Автосохранение, резервная копия, Ctrl+S.",
  "homepage_url": "https://github.com/dituals758/minimal-new-tab/",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "permissions": ["storage", "unlimitedStorage"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}